diff --git a/include/hal/pvr2_tex.h b/include/hal/pvr2_tex.h
new file mode 100644
index 0000000..d8ce36a
--- /dev/null
+++ b/include/hal/pvr2_tex.h
@@ -0,0 +1,31 @@
+/**
+ * PowerVR2 texture decoding
+ *
+ * Turns a polygon's TCW/TSP pair and the VRAM it points at into RGBA8 texels.
+ * No OpenGL here: the renderer uploads what this produces.
+ */
+
+#ifndef PVR2_TEX_H
+#define PVR2_TEX_H
+
+#include <stdint.h>
+
+/* Texture size from the TSP: 8 << n for U (bits 5:3) and V (bits 2:0). */
+#define PVR2_TSP_TEXU(tsp)  (8 << (((tsp) >> 3) & 7))
+#define PVR2_TSP_TEXV(tsp)  (8 << ((tsp) & 7))
+
+/* Twiddled (Morton) index of texel (x, y) in a w x h texture. V takes the low
+ * bit of each pair; a rectangle is a run of min(w,h) squares along its long
+ * side. */
+uint32_t pvr2_twiddle(uint32_t x, uint32_t y, uint32_t w, uint32_t h);
+
+/* Decode the top level of the texture described by tcw/tsp into out, w*h*4
+ * bytes of R,G,B,A. pal is the 1024-word palette RAM, pal_ctrl PAL_RAM_CTRL,
+ * text_control TEXT_CONTROL (stride). Returns 0, or -1 if it does not fit in
+ * VRAM. */
+int pvr2_tex_decode(const uint8_t *vram, uint32_t vram_size,
+                    uint32_t tcw, uint32_t tsp,
+                    const uint32_t *pal, uint32_t pal_ctrl, uint32_t text_control,
+                    uint8_t *out);
+
+#endif /* PVR2_TEX_H */
