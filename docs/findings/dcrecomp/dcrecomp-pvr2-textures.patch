diff --git a/src/hal/pvr2_tex.c b/src/hal/pvr2_tex.c
new file mode 100644
index 0000000..8c97ce8
--- /dev/null
+++ b/src/hal/pvr2_tex.c
@@ -0,0 +1,156 @@
+/**
+ * PowerVR2 texture decoding
+ *
+ * TCW: [20:0] address in 64-bit units, [25] stride select, [26] scan order
+ * (1 = not twiddled), [29:27] pixel format, [30] VQ, [31] mipmapped. Palette
+ * formats reuse [26:21] as the palette selector and are always twiddled.
+ */
+
+#include "hal/pvr2_tex.h"
+#include <string.h>
+
+enum { FMT_1555, FMT_565, FMT_4444, FMT_YUV422, FMT_BUMP, FMT_PAL4, FMT_PAL8, FMT_RES };
+
+/* Offset of the top mip level, in texels, indexed by log2(size). The levels
+ * are stored smallest first; 16bpp multiplies by 2, PAL8 by 1, PAL4 halves. */
+static const uint32_t k_mip_point[11] = {
+    0x00003, 0x00004, 0x00008, 0x00018, 0x00058, 0x00158,
+    0x00558, 0x01558, 0x05558, 0x15558, 0x55558 };
+/* The same for VQ, in index bytes past the codebook. */
+static const uint32_t k_vq_mip_point[11] = {
+    0x00000, 0x00001, 0x00002, 0x00006, 0x00016, 0x00056,
+    0x00156, 0x00556, 0x01556, 0x05556, 0x15556 };
+
+uint32_t pvr2_twiddle(uint32_t x, uint32_t y, uint32_t w, uint32_t h) {
+    uint32_t m = w < h ? w : h;
+    uint32_t idx = 0;
+    int sh = 0;
+    for (uint32_t b = 1; b < m; b <<= 1) {
+        if (y & b) idx |= 1u << sh;
+        sh++;
+        if (x & b) idx |= 1u << sh;
+        sh++;
+    }
+    uint32_t block = w > h ? x / m : y / m;
+    return idx + block * m * m;
+}
+
+static int ilog2(uint32_t v) { int n = 0; while (v > 1) { v >>= 1; n++; } return n; }
+
+static void put(uint8_t *o, uint32_t r, uint32_t g, uint32_t b, uint32_t a) {
+    o[0] = (uint8_t)r; o[1] = (uint8_t)g; o[2] = (uint8_t)b; o[3] = (uint8_t)a;
+}
+
+static void unpack16(uint16_t p, int fmt, uint8_t *o) {
+    switch (fmt) {
+    case FMT_565:
+        put(o, ((p >> 11) & 0x1F) * 255 / 31, ((p >> 5) & 0x3F) * 255 / 63,
+            (p & 0x1F) * 255 / 31, 255);
+        break;
+    case FMT_4444:
+        put(o, ((p >> 8) & 0xF) * 17, ((p >> 4) & 0xF) * 17, (p & 0xF) * 17,
+            ((p >> 12) & 0xF) * 17);
+        break;
+    case FMT_BUMP: /* shortcut: bump maps read as flat grey, until lighting needs them */
+        put(o, 128, 128, 128, 255);
+        break;
+    default: /* 1555, and the reserved format reads like it */
+        put(o, ((p >> 10) & 0x1F) * 255 / 31, ((p >> 5) & 0x1F) * 255 / 31,
+            (p & 0x1F) * 255 / 31, (p & 0x8000) ? 255 : 0);
+        break;
+    }
+}
+
+static uint32_t clamp8(int v) { return v < 0 ? 0 : v > 255 ? 255 : (uint32_t)v; }
+
+/* One texel of a YUV422 pair: word0 = Y0<<8 | U, word1 = Y1<<8 | V. */
+static void unpack_yuv(uint16_t w0, uint16_t w1, int odd, uint8_t *o) {
+    int u = (w0 & 0xFF) - 128, v = (w1 & 0xFF) - 128;
+    int y = odd ? (w1 >> 8) : (w0 >> 8);
+    put(o, clamp8(y + (11 * v) / 8), clamp8(y - (11 * u) / 32 - (23 * v) / 32),
+        clamp8(y + (111 * u) / 64), 255);
+}
+
+static void unpack_pal(uint32_t e, uint32_t pal_ctrl, uint8_t *o) {
+    if ((pal_ctrl & 3) == 3)
+        put(o, (e >> 16) & 0xFF, (e >> 8) & 0xFF, e & 0xFF, e >> 24);
+    else
+        unpack16((uint16_t)e, (int)(pal_ctrl & 3), o);
+}
+
+int pvr2_tex_decode(const uint8_t *vram, uint32_t vram_size,
+                    uint32_t tcw, uint32_t tsp,
+                    const uint32_t *pal, uint32_t pal_ctrl, uint32_t text_control,
+                    uint8_t *out) {
+    uint32_t w = PVR2_TSP_TEXU(tsp), h = PVR2_TSP_TEXV(tsp);
+    uint32_t addr = (tcw & 0x1FFFFF) << 3;
+    int fmt = (tcw >> 27) & 7;
+    int vq = (tcw >> 30) & 1;
+    int mip = (tcw >> 31) & 1;
+    int pal_fmt = fmt == FMT_PAL4 || fmt == FMT_PAL8;
+    int twiddled = pal_fmt || vq || !((tcw >> 26) & 1);
+    int stride = !pal_fmt && !twiddled && ((tcw >> 25) & 1);
+    uint32_t pitch = stride ? (text_control & 0x1F) * 32 : w;
+    if (stride && pitch == 0) pitch = w;
+    int lg = ilog2(w);
+
+    /* Bytes the texture covers, to check it against VRAM once. */
+    uint32_t data = addr, span;
+    if (vq) {
+        data = addr + 2048;
+        if (mip) data += k_vq_mip_point[lg];
+        span = data - addr + (w / 2) * (h / 2);
+    } else {
+        if (mip) {
+            uint32_t mp = k_mip_point[lg];
+            data += fmt == FMT_PAL4 ? mp / 2 : fmt == FMT_PAL8 ? mp : mp * 2;
+        }
+        uint32_t texels = pitch * h;
+        span = data - addr + (fmt == FMT_PAL4 ? texels / 2 : fmt == FMT_PAL8 ? texels : texels * 2);
+    }
+    if (addr >= vram_size || span > vram_size - addr) {
+        memset(out, 0xFF, (size_t)w * h * 4);
+        return -1;
+    }
+
+    uint32_t pal_base = fmt == FMT_PAL4 ? ((tcw >> 21) & 0x3F) << 4
+                                        : ((tcw >> 25) & 3) << 8;
+
+    for (uint32_t y = 0; y < h; y++) {
+        for (uint32_t x = 0; x < w; x++) {
+            uint8_t *o = out + ((size_t)y * w + x) * 4;
+            if (vq) {
+                uint32_t code = vram[data + pvr2_twiddle(x / 2, y / 2, w / 2, h / 2)];
+                uint32_t e = addr + code * 8 + pvr2_twiddle(x & 1, y & 1, 2, 2) * 2;
+                uint16_t p = (uint16_t)(vram[e] | vram[e + 1] << 8);
+                if (fmt == FMT_YUV422) { /* shortcut: VQ YUV decodes as luma only, until a game uses it */
+                    uint32_t l = p >> 8;
+                    put(o, l, l, l, 255);
+                } else {
+                    unpack16(p, fmt, o);
+                }
+            } else if (fmt == FMT_PAL4) {
+                uint32_t i = pvr2_twiddle(x, y, w, h);
+                uint32_t nib = (vram[data + i / 2] >> ((i & 1) * 4)) & 0xF;
+                unpack_pal(pal[(pal_base + nib) & 1023], pal_ctrl, o);
+            } else if (fmt == FMT_PAL8) {
+                uint32_t i = pvr2_twiddle(x, y, w, h);
+                unpack_pal(pal[(pal_base + vram[data + i]) & 1023], pal_ctrl, o);
+            } else if (fmt == FMT_YUV422) {
+                /* Pairs run along U; twiddled pairs are the two texels of a
+                 * 2x2 block that share a row. */
+                uint32_t x0 = x & ~1u;
+                uint32_t i0 = twiddled ? pvr2_twiddle(x0, y, w, h) : y * pitch + x0;
+                uint32_t i1 = twiddled ? pvr2_twiddle(x0 + 1, y, w, h) : i0 + 1;
+                uint16_t w0 = (uint16_t)(vram[data + i0 * 2] | vram[data + i0 * 2 + 1] << 8);
+                uint16_t w1 = (uint16_t)(vram[data + i1 * 2] | vram[data + i1 * 2 + 1] << 8);
+                unpack_yuv(w0, w1, (int)(x & 1), o);
+            } else {
+                if (stride && x >= pitch) { put(o, 0, 0, 0, 0); continue; }
+                uint32_t i = twiddled ? pvr2_twiddle(x, y, w, h) : y * pitch + x;
+                unpack16((uint16_t)(vram[data + i * 2] | vram[data + i * 2 + 1] << 8), fmt, o);
+            }
+        }
+    }
+    return 0;
+}
diff --git a/tests/pvr2_tex_selftest.c b/tests/pvr2_tex_selftest.c
new file mode 100644
index 0000000..9f359e9
--- /dev/null
+++ b/tests/pvr2_tex_selftest.c
@@ -0,0 +1,86 @@
+/* Self-check for PVR2 texture decoding. Covers the parts that are silent when
+ * wrong: twiddle order (square and rectangular), the scan-order and palette
+ * bits, VQ codebook lookup, the mip offset and the VRAM bounds check.
+ *
+ *   cl /nologo /I include tests\pvr2_tex_selftest.c src\hal\pvr2_tex.c && pvr2_tex_selftest.exe
+ */
+
+#undef NDEBUG   /* the checks are the test; keep them in Release builds */
+#include "hal/pvr2_tex.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static uint8_t vram[0x10000];
+static uint32_t pal[1024];
+static uint8_t out[64 * 64 * 4];
+
+#define TSP_8x8   0x00u            /* U = V = 8 */
+#define TSP_16x8  (1u << 3)        /* U = 16, V = 8 */
+#define FMT(f)    ((uint32_t)(f) << 27)
+#define SCAN      (1u << 26)       /* not twiddled */
+
+static void put16(uint32_t off, uint16_t v) { vram[off] = (uint8_t)v; vram[off + 1] = (uint8_t)(v >> 8); }
+static const uint8_t *px(int w, int x, int y) { return out + ((size_t)y * w + x) * 4; }
+
+int main(void) {
+    /* Twiddle: V takes the low bit. */
+    assert(pvr2_twiddle(0, 0, 8, 8) == 0);
+    assert(pvr2_twiddle(0, 1, 8, 8) == 1);
+    assert(pvr2_twiddle(1, 0, 8, 8) == 2);
+    assert(pvr2_twiddle(1, 1, 8, 8) == 3);
+    assert(pvr2_twiddle(0, 2, 8, 8) == 4);
+    assert(pvr2_twiddle(2, 0, 8, 8) == 8);
+    assert(pvr2_twiddle(7, 7, 8, 8) == 63);
+    /* 16x8 is two 8x8 squares side by side. */
+    assert(pvr2_twiddle(8, 0, 16, 8) == 64);
+    assert(pvr2_twiddle(9, 1, 16, 8) == 67);
+
+    /* Non-twiddled 565: texel (2,1) red. */
+    memset(vram, 0, sizeof vram);
+    put16((1 * 8 + 2) * 2, 0xF800);
+    assert(pvr2_tex_decode(vram, sizeof vram, FMT(1) | SCAN, TSP_8x8, pal, 0, 0, out) == 0);
+    assert(px(8, 2, 1)[0] == 255 && px(8, 2, 1)[1] == 0 && px(8, 2, 1)[3] == 255);
+    assert(px(8, 1, 2)[0] == 0);
+
+    /* Twiddled 1555 at address 0x800 (tcw units of 8): texel (1,0) is index 2. */
+    memset(vram, 0, sizeof vram);
+    put16(0x800 + 2 * 2, 0x801F);   /* opaque blue */
+    assert(pvr2_tex_decode(vram, sizeof vram, FMT(0) | (0x800 >> 3), TSP_8x8, pal, 0, 0, out) == 0);
+    assert(px(8, 1, 0)[2] == 255 && px(8, 1, 0)[3] == 255);
+    assert(px(8, 0, 1)[3] == 0);
+
+    /* PAL8, selector 1 (entries 256..511), ARGB8888 palette. */
+    memset(vram, 0, sizeof vram);
+    pal[256 + 5] = 0xFF00FF00u;
+    vram[pvr2_twiddle(3, 2, 8, 8)] = 5;
+    assert(pvr2_tex_decode(vram, sizeof vram, FMT(6) | (1u << 25), TSP_8x8, pal, 3, 0, out) == 0);
+    assert(px(8, 3, 2)[1] == 255 && px(8, 3, 2)[0] == 0 && px(8, 3, 2)[3] == 255);
+
+    /* PAL4, selector 2 (entries 32..47): odd index takes the high nibble. */
+    memset(vram, 0, sizeof vram);
+    pal[32 + 9] = 0xFFFF0000u;
+    { uint32_t i = pvr2_twiddle(0, 1, 8, 8); vram[i / 2] = (uint8_t)(9 << ((i & 1) * 4)); }
+    assert(pvr2_tex_decode(vram, sizeof vram, FMT(5) | (2u << 21), TSP_8x8, pal, 3, 0, out) == 0);
+    assert(px(8, 0, 1)[0] == 255 && px(8, 0, 0)[0] == 0);
+
+    /* VQ 565: block (1,0) uses code 7; its texel (1,0) is codebook slot 2. */
+    memset(vram, 0, sizeof vram);
+    put16(7 * 8 + 2 * 2, 0x07E0);   /* green */
+    vram[2048 + pvr2_twiddle(1, 0, 4, 4)] = 7;
+    assert(pvr2_tex_decode(vram, sizeof vram, FMT(1) | (1u << 30), TSP_8x8, pal, 0, 0, out) == 0);
+    assert(px(8, 3, 0)[1] == 255 && px(8, 2, 0)[1] == 0);
+
+    /* Mipmapped 16bpp 8x8: the top level starts 0x18 texels in. */
+    memset(vram, 0, sizeof vram);
+    put16(0x18 * 2, 0xF800);
+    assert(pvr2_tex_decode(vram, sizeof vram, FMT(1) | (1u << 31), TSP_8x8, pal, 0, 0, out) == 0);
+    assert(px(8, 0, 0)[0] == 255);
+
+    /* Past the end of VRAM: refused, filled white. */
+    assert(pvr2_tex_decode(vram, sizeof vram, FMT(1) | (0x1FFFFF), TSP_16x8, pal, 0, 0, out) == -1);
+    assert(px(16, 0, 0)[0] == 255);
+
+    printf("pvr2_tex selftest: ok\n");
+    return 0;
+}
